# URL de base du téléchargement BDPM (le nom de fichier est ajouté automatiquement, ex: .../CIS_bdpm.txt)
BDPM_BASE_URL=https://base-donnees-publique.medicaments.gouv.fr/download/file

# Encodage des fichiers plats BDPM
BDPM_ENCODING=latin-1

# Répertoire de données (contient raw/ et bdpm.sqlite)
BDPM_DATA_DIR=./data

# Chemin explicite de la base SQLite servie par l'API (surcharge BDPM_DATA_DIR)
# BDPM_DB_PATH=./data/bdpm.sqlite

# Port d'écoute de l'API (utilisé par le Dockerfile / docker-compose)
PORT=8090

# Clé requise dans le header X-Admin-Key pour appeler POST /admin/update-database.
# Laisser vide en dev local (aucune vérification imposée) ; définir en production.
ADMIN_API_KEY=
